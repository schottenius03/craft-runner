<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/frameLayout3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.app.DashboardFragment">

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="79dp"
        android:layout_height="72dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/editTextSearch"
        android:layout_width="265dp"
        android:layout_height="43dp"
        android:layout_marginTop="32dp"
        android:ems="10"
        android:hint="What are you looking for?"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.334"
        app:layout_constraintStart_toEndOf="@+id/imageView4"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageViewEmbroidery"
        android:layout_width="130dp"
        android:layout_height="90dp"
        android:layout_marginStart="49dp"
        android:layout_marginTop="44dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/embroidery"
        app:layout_constraintBottom_toTopOf="@+id/textViewEmbroidery"
        app:layout_constraintStart_toEndOf="@+id/textViewProfile"
        app:layout_constraintTop_toBottomOf="@+id/editTextSearch" />

    <TextView
        android:id="@+id/textViewEmbroidery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="62dp"
        android:layout_marginEnd="47dp"
        android:text="Embroidery"
        android:textSize="20sp"
        app:layout_constraintBaseline_toBaselineOf="@+id/textViewHooks"
        app:layout_constraintEnd_toStartOf="@+id/textViewHooks"
        app:layout_constraintStart_toEndOf="@+id/textViewSettings" />

    <ImageView
        android:id="@+id/imageViewHook"
        android:layout_width="139dp"
        android:layout_height="99dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="44dp"
        android:layout_marginBottom="21dp"
        android:src="@drawable/crochethooks"
        app:layout_constraintBottom_toTopOf="@+id/textViewHooks"
        app:layout_constraintStart_toEndOf="@+id/imageViewEmbroidery"
        app:layout_constraintTop_toBottomOf="@+id/editTextSearch" />

    <TextView
        android:id="@+id/textViewHooks"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="47dp"
        android:layout_marginTop="21dp"
        android:layout_marginBottom="145dp"
        android:text="Crochet hooks"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textViewEmbroidery"
        app:layout_constraintTop_toBottomOf="@+id/imageViewHook" />

    <ImageView
        android:id="@+id/imageViewAddNewItem"
        android:layout_width="140dp"
        android:layout_height="118dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="107dp"
        android:layout_marginBottom="17dp"
        android:src="@drawable/delivery"
        app:layout_constraintBottom_toTopOf="@+id/textViewAddNewItem"
        app:layout_constraintStart_toEndOf="@+id/imageViewHook"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewAddNewItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="45dp"
        android:layout_marginTop="21dp"
        android:layout_marginBottom="138dp"
        android:text="Item configuration"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textViewHooks"
        app:layout_constraintTop_toBottomOf="@+id/imageViewAddNewItem" />

    <TextView
        android:id="@+id/textViewProfile"
        android:layout_width="136dp"
        android:layout_height="52dp"
        android:gravity="center"
        android:text="Profile"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/textViewSettings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewSearch" />

    <TextView
        android:id="@+id/textViewSearch"
        android:layout_width="135dp"
        android:layout_height="52dp"
        android:layout_marginTop="50dp"
        android:gravity="center"
        android:text="Search"
        android:textColor="#57D3CB"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/textViewProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView4" />

    <TextView
        android:id="@+id/textViewSettings"
        android:layout_width="139dp"
        android:layout_height="52dp"
        android:layout_marginBottom="117dp"
        android:gravity="center"
        android:text="Settings"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewProfile" />

</androidx.constraintlayout.widget.ConstraintLayout>